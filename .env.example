NODE_ENV=development
PORT=9999

# Database URLs (For Supabase / Connection Poolers)
DATABASE_URL="postgresql://postgres.[project-ref]:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:password@aws-0-region.pooler.supabase.com:5432/postgres"

JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (Dùng REDIS_URL hoặc tách riêng REDIS_HOST / REDIS_PORT / REDIS_PASSWORD)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_ENABLED=true

# Master Encryption Key (32 bytes string/hex for AES-256-GCM secret encryption)
APP_SECRET=your_32_character_master_secret_key!
ENCRYPTION_KEY=your_32_character_master_secret_key!

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_gmail_user@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM="App Template <noreply@gmail.com>"
APP_URL=http://localhost:7777

# Security Settings
# Can be: true, false, loopback, linklocal, uniquelocal, specific IP/CIDR (e.g. 10.0.0.1,10.0.0.0/8), or number of hops
TRUST_PROXY=false

# CORS Whitelist (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:7777,http://localhost:3000,http://localhost:5173

# Rate Limiting (API General: 1000 req / 15m; Auth Sensitive: 30 req / 15m)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=30

# Cloudflare R2 (server-side only; never expose credentials to the browser)
R2_ACCOUNT_ID=your_r2_account_id
R2_BUCKET_NAME=your_r2_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_BASE_URL=https://your-public-r2-url.r2.dev
R2_PRESIGNED_URL_EXPIRES_IN_SECONDS=300
R2_AVATAR_MAX_FILE_SIZE_MB=5

NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=60000

AI_PROVIDER=gemini
GEMINI_API_KEYS=key1,key2
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CONTEXT_TRANSACTIONS=200
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_RATE_LIMIT_WINDOW_MS=900000

# Discord OAuth & Ecosystem
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:8888/api/v1/auth/discord/callback
FRONTEND_URL=http://localhost:3000
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_guild_id
DISCORD_INVITE_URL=https://discord.gg/your-invite-code
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url